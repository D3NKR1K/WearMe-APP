<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <application
    android:allowBackup="true"

    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.WearMe"
    android:usesCleartextTraffic="true">

    <activity
      android:name=".ui.bio.MeasurementsActivity"
      android:theme="@style/Theme.WearMe"
      android:exported="false" />

    <activity
      android:name=".ui.home.ProductsActivity"
      android:theme="@style/Theme.WearMe"
      android:exported="false" />

    <activity
      android:name=".ui.auth.SignInActivity"
      android:theme="@style/Theme.WearMe"
      android:exported="false" />

    <activity
      android:name=".ui.auth.SignUpActivity"
      android:theme="@style/Theme.WearMe"
      android:exported="false" />

    <activity
      android:name=".ui.bio.ProfileActivity"
      android:theme="@style/Theme.WearMe"
      android:exported="false" />

    <activity
      android:name=".ui.home.MainActivity"
      android:theme="@style/Theme.WearMe.Starting"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <meta-data
      android:name="preloaded_fonts"
      android:resource="@array/preloaded_fonts" />
  </application>

</manifest>