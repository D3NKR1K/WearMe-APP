<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!-- Общий стиль для TextInputLayout -->
  <style name="InputLayout" parent="Theme.WearMe">
    <item name="boxStrokeColor">@android:color/darker_gray</item>
    <item name="boxCornerRadiusBottomEnd">4dp</item>
    <item name="boxCornerRadiusTopEnd">4dp</item>
    <item name="boxCornerRadiusBottomStart">4dp</item>
    <item name="boxCornerRadiusTopStart">4dp</item>
    <item name="cursorColor">#88673AB7</item>
    <item name="boxStrokeErrorColor">#E91E63</item>
    <item name="errorTextColor">#E91E63</item>
    <item name="errorIconDrawable">@null</item>
    <item name="hintTextColor">#88673AB7</item>
    <item name="startIconTint">@android:color/darker_gray</item>
    <item name="endIconTint">@android:color/darker_gray</item>
  </style>

  <style name="NavButton" parent="Widget.MaterialComponents.Button">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">48dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="backgroundTint">@color/button_main_color</item>
    <item name="fontFamily">@font/jua</item>
    <item name="cornerRadius">8dp</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="SettingsItem" parent="TextAppearance.AppCompat.Body1">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:padding">16dp</item>
    <item name="android:textColor">@color/black</item>
    <item name="android:textSize">16sp</item>
    <item name="android:drawablePadding">16dp</item>
  </style>

  <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButton</item>
    <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButton</item>
  </style>

  <style name="AlertDialogButton" parent="Widget.Material3.Button.TextButton">
    <item name="android:textColor">@color/button_main_color</item>
  </style>

</resources>