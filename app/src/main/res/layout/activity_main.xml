<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/white"
  tools:context=".ui.home.ProductsActivity">

  <!-- Заголовок -->
  <TextView
    android:id="@+id/toolbarTitle"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="24dp"
    android:fontFamily="@font/jua"
    android:gravity="center"
    android:text="Clothes database"
    android:textColor="@color/black"
    android:textSize="24sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <!-- Лента товаров -->
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/productsRecyclerView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginTop="16dp"
    android:overScrollMode="never"
    android:paddingHorizontal="8dp"
    android:scrollbars="vertical"
    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
    app:layout_constraintBottom_toTopOf="@id/productsBottomPanel"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/toolbarTitle"
    app:spanCount="2"
    tools:itemCount="6"
    tools:listitem="@layout/item_product" />

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/categoriesRecyclerView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginTop="16dp"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/toolbarTitle"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toTopOf="@id/productsBottomPanel"
    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
    tools:listitem="@layout/item_category"
    tools:orientation="vertical" />

  <!-- Нижняя панель -->
  <LinearLayout
    android:id="@+id/productsBottomPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/productsShowcaseButton"
      style="@style/NavButton"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginHorizontal="2dp"
      android:text="Showcase" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/productsCatalogButton"
      style="@style/NavButton"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginHorizontal="2dp"
      android:text="Catalog" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/productsFeautersButton"
      style="@style/NavButton"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginHorizontal="2dp"
      android:text="♥" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/productsProfileButton"
      style="@style/NavButton"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginHorizontal="2dp"
      android:text="Profile" />
  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>