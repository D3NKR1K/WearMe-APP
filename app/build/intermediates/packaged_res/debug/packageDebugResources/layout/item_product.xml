<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_margin="2dp"
  app:cardCornerRadius="8dp"
  app:cardElevation="2dp"
  app:cardUseCompatPadding="true">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <!-- Изображение товара -->
    <ImageView
      android:id="@+id/product_image"
      android:layout_width="0dp"
      android:layout_height="150dp"
      android:scaleType="centerInside"
      android:src="@drawable/placeholder_image"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <!-- Название товара -->
    <TextView
      android:id="@+id/product_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="Name"
      android:textAlignment="center"
      android:textColor="#000"
      android:textSize="18sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/product_image" />

    <!-- Контейнер для рейтинга и комментариев -->
    <LinearLayout
      android:id="@+id/rating_comments_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal"
      android:gravity="center"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/product_name">

      <!-- Рейтинг (звёзды) -->
      <TextView
        android:id="@+id/product_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="★ 4.5"
        android:textColor="@color/gold"
        android:textSize="14sp" />

      <!-- Количество комментариев -->
      <TextView
        android:id="@+id/product_comments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100 reviews"
        android:textColor="@color/dark_grey"
        android:textSize="14sp" />
    </LinearLayout>

    <!-- Кнопка "Info" -->
    <com.google.android.material.button.MaterialButton
      android:id="@+id/layout_Info_button"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_marginTop="16dp"
      android:layout_marginBottom="8dp"
      android:fontFamily="@font/jua"
      android:text="Info"
      android:textColor="@color/white"
      app:backgroundTint="@color/logo"
      app:cornerRadius="8dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/rating_comments_container"
      app:layout_constraintWidth_percent="0.9" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>